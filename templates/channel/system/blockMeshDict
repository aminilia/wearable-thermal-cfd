FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D parallel-plate channel: length L, full gap H (both in mm), 1 cell thick.
// Double-brace placeholders are filled in by coolchan/case.py

convertToMeters 0.001;

L   {{L_mm}};
H   {{H_mm}};
dz  {{dz_mm}};

vertices
(
    (0  0  0)  ($L 0  0)  ($L $H 0)  (0 $H 0)
    (0  0  $dz) ($L 0  $dz) ($L $H $dz) (0 $H $dz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) air ({{nx}} {{ny}} 1) simpleGrading (1 1 1)
);

boundary
(
    inlet      { type patch; faces ((0 4 7 3)); }
    outlet     { type patch; faces ((1 2 6 5)); }
    bottomWall { type wall;  faces ((0 1 5 4)); }
    topWall    { type wall;  faces ((3 7 6 2)); }
    frontAndBack
    {
        type empty;
        faces ((0 3 2 1) (4 5 6 7));
    }
);

// ************************************************************************* //
