FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains {{nProcs}};
method          simple;     // streamwise slabs; no external partitioner needed
simpleCoeffs    { n ({{nProcs}} 1 1); delta 0.001; }

// ************************************************************************* //
