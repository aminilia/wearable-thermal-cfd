FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Isothermal validation cases use simpleFoam. Its momentum discretisation is
// identical to the fluid region of chtMultiRegionSimpleFoam (see README).
application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         {{nIter}};
deltaT          1;
writeControl    timeStep;
writeInterval   {{writeInterval}};
purgeWrite      2;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
runTimeModifiable true;

// ************************************************************************* //
